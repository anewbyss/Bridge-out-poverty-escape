# Copy to .env (never commit .env). See README and SECURITY.md.

PORT=3000
DB_FILE=data/bridge.db

# First main-architect account (created only when the database has no staff yet).
# Leave STAFF_PASSWORD empty to get a one-time password printed at startup.
ADMIN_EMAIL=you@yourorg.org
STAFF_PASSWORD=

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
DATA_KEY=

# Production (HTTPS behind a reverse proxy)
SECURE_COOKIES=1
TRUST_PROXY=1
PUBLIC_URL=https://bridge.example.org
# Optional: only these addresses can reach the staff API (exact IPs, or prefixes ending in "." or ":")
STAFF_ALLOWED_IPS=

# Refer-me emails (Gmail: turn on 2-Step Verification, then create an App Password)
REFERRAL_EMAIL=ripchoom@gmail.com
REFERRAL_EMAIL_DETAILS=minimal
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ripchoom@gmail.com
SMTP_PASS=
MAIL_FROM=ripchoom@gmail.com
